<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="595.0" prefWidth="478.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Controller">
   <children>
      <VBox layoutX="41.0" layoutY="40.0" prefHeight="514.0" prefWidth="396.0">
         <children>
            <Label alignment="CENTER" prefHeight="26.0" prefWidth="404.0" text="KALKULATOR BMI">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            
            <Label text="BERAT BADAN (KG)">
               <VBox.margin>
                  <Insets top="30.0" />
               </VBox.margin>
            </Label>
            <TextField fx:id="txtBerat">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </TextField>
            
            <Label text="TINGGI BADAN (CM)">
               <VBox.margin>
                  <Insets top="40.0" />
               </VBox.margin>
            </Label>
            <TextField fx:id="txtTinggi">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </TextField>
            
            <Button alignment="CENTER" mnemonicParsing="false" onAction="#handleHitung" prefHeight="26.0" prefWidth="439.0" text="HITUNG" textAlignment="CENTER">
               <VBox.margin>
                  <Insets top="40.0" />
               </VBox.margin>
               <opaqueInsets>
                  <Insets left="30.0" />
               </opaqueInsets>
            </Button>
            
            <Label fx:id="lblHasil" text="HASIL BMI :">
